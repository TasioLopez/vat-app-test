# Copy to .env.local for local development.
# Prefer STAGING Supabase keys for day-to-day work — not production.
# Full setup: docs/ops/STAGING_PRODUCTION_SETUP.md

# --- App environment ---
# staging | production  (staging shows a visible test banner in the UI)
NEXT_PUBLIC_APP_ENV=staging

# --- Supabase (MUST differ between staging and production) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional alias used by some server routes; set to the same URL as NEXT_PUBLIC_SUPABASE_URL
# SUPABASE_URL=

# --- Auth redirects (MUST differ per environment) ---
# Staging:  https://staging.vat-app.nl
# Production: https://www.vat-app.nl
# Local: leave unset to use the current request origin, or set http://localhost:3000
AUTH_REDIRECT_ORIGIN=http://localhost:3000
NEXT_PUBLIC_AUTH_REDIRECT_ORIGIN=http://localhost:3000

# --- Public app URL (CV-share emails / absolute links; MUST differ per environment) ---
# Staging: https://staging.vat-app.nl
# Production: https://www.vat-app.nl
APP_PUBLIC_URL=http://localhost:3000

# --- CV share sessions (MUST use a different secret on staging vs production; min 16 chars) ---
CV_SHARE_SESSION_SECRET=

# --- OpenAI (document extraction, TP autofill) — shared key OK ---
OPENAI_API_KEY=
# Optional overrides:
# OPENAI_DOCUMENT_EXTRACTION_MODEL=gpt-5.6-sol
# OPENAI_DOCUMENT_EXTRACTION_REASONING=medium   # low | medium | high | off
# OPENAI_DOCUMENT_EXTRACTION_PDF_DETAIL=high    # low | high | auto

# --- Gotenberg — DOCX/DOC → PDF (shared Fly URL OK for staging + production) ---
# Local: docker run --rm -p 3000:3000 gotenberg/gotenberg:8
GOTENBERG_URL=http://localhost:3000
# Optional: if Gotenberg is protected with a shared secret header
# GOTENBERG_API_KEY=

# --- SMTP (CV share email; credentials can be shared across environments) ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# SMTP_FROM_NAME=
